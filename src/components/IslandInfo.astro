---
import type { Contact } from "../data/islandInfo";
import { contacts } from "../data/islandInfo";
---

<section class="px-5 py-16 flex flex-col gap-14 lg:flex-row lg:w-full lg:justify-around lg:px-0 lg:gap-0 lg:bg-light-blue lg:mt-15">
  {
    contacts.map((contact: Contact) => (
      <article class="grid grid-cols-[80px_1fr] items-center lg:grid-cols-[60px_1fr] lg:items-start">
        <picture>
          <source srcset={contact.iconDesktop} media="(min-width: 1024px)"/>
          <img class="w-10 h-10 lg:mt-1" src={ contact.icon }/>
        </picture>
        <div class=" grid grid-cols-2 items-center lg:grid-cols-1 lg:gap-4">
          <p class=" text-lg font-light text-primary-black lg:text-xl lg:text-dark-blue lg:font-semibold">{ contact.title }</p>
          <div class="text-xs flex flex-col gap-3 items-start lg:text-dark-blue">
            <p>{ contact.info }</p>
            <p>{ contact.additionalInfo }</p>
          </div>
        </div>
      </article>
    ))
  }
</section>